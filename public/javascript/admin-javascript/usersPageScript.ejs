<script>
       feather.replace();

       const userCardTemplate = document.querySelector("[data-user-template]")
       const userCardContainer = document.querySelector("[data-user-card-container]")
       const searchInput = document.querySelector("[data-search]")


      const usersString = '<%- JSON.stringify(usersFullList) %>';
      const userData = JSON.parse(usersString)
      
     
      userCardContainer.innerHTML = ""
       searchInput.addEventListener("input",(e) => {
        const value = e.target.value.toLowerCase()
        userCardContainer.style.display = "block"
          userCardContainer.innerHTML = ""
        
        if(!value){
        document.getElementById("search-icon").classList.remove("hidden")
        userCardContainer.style.display = "none"
        return;
       }else{
        document.getElementById("search-icon").classList.add("hidden")
       }
       userData.forEach(user => {
        if(user.firstName.toLowerCase().includes(value) || 
        user.lastName.toLowerCase().includes(value) || 
        user.email.toLowerCase().includes(value) ){
          const listItem = userCardTemplate.content.cloneNode(true).children[0]
          if(user.profileImage !== null){
            listItem.querySelector("[data-avatar]").src = user.profileImage
          }
          listItem.querySelector("[data-header]").textContent = user.firstName + " " + user.lastName
          listItem.querySelector("[data-body]").textContent = user.email
          listItem.style.cursor = "pointer"
          userCardContainer.appendChild(listItem)
          
          listItem.addEventListener("click",() => {
            searchInput.value = user.email
            searchInput.focus()
            userCardContainer.style.display = "none"
          })
        }
        
       });
       })



    document.addEventListener('DOMContentLoaded', () => {
        let userLog = document.getElementById("userLogged")?.value
    console.log(userLog)
    if(userLog){
        iziToast.show({
        title : "Notification",
        message: userLog,
        messageColor: '#ffffff !important',
        position: 'topCenter',
        backgroundColor: "#4f46e5", 
        titleColor: '#ffffff',
        
     })

    
    }

    });
    function blockUser(id){
      iziToast.question({
        theme : "light",
        title : "User",
        message : "Are you sure you want to block the User ?",
        position : "topCenter",
        overlay : true,
        close : false,
        id : "blockUser",
        zindex : 9999,
        timeout : 30000,
        backgroundColor : "white", 
        buttons : [
            ["<button>OK</button>",function(instance,toast){
                instance.hide({transitionOut : "fadeOut"},toast,'button')

                fetch(`/admin/block-user?id=${id}`,{method : "PATCH"})
                .then(res => res.json() )
                .then(data => {
                    window.location.href = "/admin/users"   
                })
                .catch(error => iziToast.error({
                    title : error.name ,
                    message : error.message,
                    position : "topRight"
                }))

            }],
            ["<button>Cancel</button>",function(instance,toast){
                instance.hide({transitionOut : "fadeOut"},toast,'button')
                
            }]
        ]
    })
        
    }
    function unblockUser(id){
      iziToast.question({
        theme : "light",
        title : "User",
        message : "Are you sure you want to Unblock the user ?",
        position : "topCenter",
        overlay : true,
        close : false,
        id : "blockUser",
        zindex : 9999,
        timeout : 30000,
        backgroundColor : "white", 
        buttons : [
            ["<button>OK</button>",function(instance,toast){
                instance.hide({transitionOut : "fadeOut"},toast,'button')

                fetch(`/admin/unblock-user?id=${id}`,{method : "PATCH"})
                .then(res => res.json() )
                .then(data => {
                    window.location.href = "/admin/users"   
                })
                .catch(error => iziToast.error({
                    title : error.name ,
                    message : error.message,
                    position : "topRight"
                }))

            }],
            ["<button>Cancel</button>",function(instance,toast){
                instance.hide({transitionOut : "fadeOut"},toast,'button')
                
            }]
        ]
    })
    }
   
    
let serverMessage = '<%- message %>'
if(serverMessage){
  if(serverMessage === "User has been successfully Blocked"){
    iziToast.success({
      title : "User",
      message : serverMessage,
      position : "topRight"
    })
  }
  if(serverMessage === "User has been successfully Unblocked"){
    iziToast.success({
      title : "User",
      message : serverMessage,
      position : "topRight"
    })
  }
}
if(serverMessage === "Something went wrong. Please try again later"){
    iziToast.error({
      title : "Error",
      message: serverMessage,
     position: 'topRight'
    })
    
  }
    
 </script>
</body>
</html>