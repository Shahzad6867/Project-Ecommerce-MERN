<%- include("../partials/user-side/navbar.ejs",{title : "Novamart - Order Details"})%>
    <div class="main-content">
        <input type="text" id="serverMessage" value="<%= message %>" hidden>
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold">Order Details</h1>
                <% if (!order.isCancelled) { %>
                    <p class="text-gray-600">Order <%= order.orderId %> • Placed on <%= new Date(order.createdAt).toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    })%></p>
                    </p>
                  <% } else{ %>
                    <p class="text-gray-600">Order <%= order.orderId %> • Cancelled on <%= new Date(order.items[order.items.length - 1].statusTimeline.cancelledAt).toLocaleDateString("en-IN", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    })%></p>
                    <% } %>
                
            </div>
            
            <div class="flex">
                <button type="button" class="px-4 py-2 mr-2 bg-white border text-black rounded-md hover:bg-gray-100 flex items-center" onclick="reorder('<%= order._id %>')" >
                    <i data-feather="repeat" class="w-4 h-4 mr-2"></i> Reorder
                </button>
                <% if (order.invoiceUrl !== null && order.invoiceCreatedAt !== null) { %>
                        <a href="<%= order.invoiceUrl %>" download>
                            <button type="button" id="downloadInvoiceBtn" class="px-4 py-2 ml-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 flex items-center" onclick="downloadInvoice('<%- order._id %>')">
                                <i data-feather="download" class="w-4 h-4 mr-2"></i> Download Invoice
                            </button>
                        </a>
                <% } %>
                <% if ((order.paymentId.status === "Pending" || order.paymentId.status === "Payment Failed") && order.paymentId.paymentMethod === "Pay with Stripe" && !order.isCancelled) { %>
                    <a href="/orders/<%= order._id %>/pending-payment">
                        <button type="button" class="px-4 py-2 bg-yellow-400 text-gray-700 hover:bg-yellow-300 mr-2 rounded-md font-bold flex items-center" onclick="removeProcessingRequestOverlay()">
                            <i data-feather="credit-card" class="w-4 h-4 mr-2"></i>
                            Complete Payment
                        </button>
                    </a>
                  <% } %>
                <% if (!order.isCancelled && order.items.every(item => item.status === "Placed" || item.status === "Cancelled" ) && !( order.paymentId.paymentMethod === "Pay with Stripe" && ( order.paymentId.status === "Pending" || order.paymentId.status === "Payment Failed"))) { %>
                    <button type="button" class="px-4 py-2  bg-red-400 font-bold text-black rounded-md hover:bg-red-600 flex items-center" onclick="cancelOrder('<%= order._id %>')">
                        Cancel Order
                    </button>
                <% } %>
                <% if ( !order.isCancelled && !order.isReturned && order.items.every(item => item.status === "Delivered" || item.status === "Cancelled" )) { %>
                    <button type="button" class="px-4 py-2 ml-2 btn-primary font-bold text-black rounded-md flex items-center" onclick="openReturnModalForOrder('<%= order._id %>')">
                        <i data-feather="rotate-ccw" class="w-4 h-4 mr-2"></i>
                        Return Order
                    </button>
                <% } %>

            </div>
        </div>
        <% if ((order.paymentId.status === "Pending" || order.paymentId.status === "Payment Failed") && order.paymentId.paymentMethod === "Pay with Stripe" && !order.isCancelled) { %>
            <div class="flex items-center rounded-xl px-2 py-[0.2rem] bg-yellow-300 w-[66%] mb-3">
                <i data-feather="alert-triangle" class="w-5 h-5 mr-1"></i>
                <p class="text-sm text-black">
                  Please complete the payment by <span class="font-bold" ><%= new Date(order.willBeCancelledAt).toLocaleDateString("en-IN", {day: "numeric",month: "short",year: "numeric"
                }) %>, </span><span class="font-bold"><%= new Date(order.willBeCancelledAt).toLocaleTimeString('en-US', {   hour: '2-digit',minute: '2-digit',  hour12: true }) %></span>
                  If payment is not received by then, this order will be automatically cancelled.
                 </p>
               </div>
          <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            
            
            <div class="lg:col-span-2">
                <div class="order-card p-6 mb-6 border">
                    <div class="flex justify-between items-center ">
                        <h2 class="text-xl font-bold ">Order Summary</h2> 
                    </div>

                   
                    <div class="divide-y divide-gray-200">
                        <% let nonCancelledItemsLen = 0 %>
                        <% let sumOfQuantity = 0 %>
                        <% order.items.forEach(element => {
                            if(!element.isCancelled){
                                nonCancelledItemsLen++
                            }
                             sumOfQuantity += element.quantity             
                        }); %>
                        <% for( let i = 0; i < order.items.length; i++ ) { %>
                            
                            <div class="py-2 flex items-center">
                                
                              
                                    <img src="<%= order.items[i].productImage %>" class="product-image border rounded <%= (order.items[i].isCancelled) ? "opacity-50" : "" %>" alt="Product">
                                    <div class="py-4 flex flex-wrap items-center w-[50%]">
                                       
                                        <div class="ml-4 flex-1 ">
                                            <h4 class="font-medium <%= (order.items[i].isCancelled) ? "text-gray-400" : "text-black" %>"><%= order.items[i].productName %></h4>
                                            <p class="text-sm <%= (order.items[i].isCancelled) ? "text-gray-400" : "text-black" %>">Color: <%= order.items[i].color %></p>
                                            <p class="text-sm <%= (order.items[i].isCancelled) ? "text-gray-400" : "text-black" %>">Size: <%= order.items[i].size %></p>
                                            <p class="text-sm <%= (order.items[i].isCancelled) ? "text-gray-400" : "text-black" %> mt-1">Qty: <%= order.items[i].quantity %></p>
                                            <p class="font-medium <%= (order.items[i].isCancelled) ? "text-gray-400" : "text-black" %>">Price : $<%= order.items[i].offerPrice %></p>
                                        </div>
                                       
                                    </div>
                                
                               
                                
                                    <div class="flex flex-col w-[50%] items-end h-[9rem]">

                                        <span class="px-3 py-1 mt-3 rounded-full text-sm font-bold whitespace-nowrap
                                            <% let status = order.items[i].status %>
                                                <%= status === 'Placed' ? 'bg-gray-100 text-gray-700' :
                                                    status === 'Processed' ? 'bg-yellow-100 text-yellow-700' : 
                                                    status === 'Shipped' ? 'bg-blue-100 text-blue-700' : 
                                                    status === 'Delivered' ? 'bg-green-100 text-green-700' : 
                                                    status === 'Cancelled' ? 'bg-red-100 text-red-700' :
                                                    status === 'Return Requested' ? 'bg-yellow-400  text-black' :
                                                    status === 'Return Request Approved' ? 'bg-green-400  text-black' :
                                                    status === 'Return Request Declined' ? 'bg-red-400  text-black' :
                                                        'bg-gray-100 text-gray-700' %>">
                                            
                                                    <%= status %>
                                        </span>
                                        
                                        <% if (order.items[i].status === "Placed" && !order.items[i].isCancelled && nonCancelledItemsLen > 1 && !( order.paymentId.paymentMethod === "Pay with Stripe" && ( order.paymentId.status === "Pending" || order.paymentId.status === "Payment Failed"))) { %>
                                           <button type="button" class="bg-red-400 hover:bg-red-500 p-2 my-auto font-bold rounded-xl" onclick="cancelItem('<%= order._id %>','<%= order.items[i]._id %>')" >Cancel Item</button>
                                        <% }%>
                                        <% if (order.items[i].status === "Delivered" && !order.items[i].return.isRequested && nonCancelledItemsLen > 1) { %>
                                            <button type="button" class="px-4 py-2 btn-primary font-bold my-auto text-black rounded-xl" onclick="openReturnModalForItem('<%- order._id %>','<%- i %>')">
                                                Return Item
                                            </button>
                                         <% }%>
                                    </div>
                                 
                            </div>
                            <% if (order.items[i].isCancelled && order.paymentId.paymentMethod !== "Cash on Delivery") { %>
                                <div class="flex items-center rounded-xl px-2 py-[0.2rem] bg-red-300 w-full mb-3">
                                    <i data-feather="info" class="w-5 h-5 mr-1"></i>
                                    <p class="text-sm text-black">
                                      Item has been cancelled. Appropriate amount will be refunded to the Orginal Payment Method
                                     </p>
                                   </div>
                            <% } %>
                            <% if (order.items[i].return.declinedAt !== null && order.items[i].status === "Return Request Declined") { %>
                                <div class="flex items-center rounded-xl px-2 py-[0.2rem] bg-red-300 w-full mb-3">
                                    <i data-feather="info" class="w-5 h-5 mr-1"></i>
                                    <p class="text-sm text-black">
                                      Return Request has been Declined at <span class="font-bold" ><%= new Date(order.items[i].return.declinedAt).toLocaleDateString("en-IN", {day: "numeric",month: "short",year: "numeric"
                                    }) %>, </span><span class="font-bold"><%= new Date(order.items[i].return.declinedAt).toLocaleTimeString('en-US', {   hour: '2-digit',minute: '2-digit',  hour12: true }) %>.</span>
                                      <strong> Reason : </strong><%= order.items[i].return.declineReason %>
                                     </p>
                                   </div>
                            <% } %>
                            <% if (order.items[i].return.approvedAt !== null && order.items[i].status === "Return Request Approved" ) { %>
                                <div class="flex items-center rounded-xl px-2 py-[0.2rem] bg-green-300 w-full mb-3">
                                    <i data-feather="info" class="w-5 h-5 mr-1"></i>
                                    <p class="text-sm text-black">
                                      Return Request has been Approved at <span class="font-bold" ><%= new Date(order.items[i].return.approvedAt).toLocaleDateString("en-IN", {day: "numeric",month: "short",year: "numeric"
                                    }) %>, </span><span class="font-bold"><%= new Date(order.items[i].return.approvedAt).toLocaleTimeString('en-US', {   hour: '2-digit',minute: '2-digit',  hour12: true }) %>.</span>
                                      The amount has been refunded to your <strong> NovaWallet </strong>
                                     </p>
                                   </div>
                            <% } %>
                        <% } %>
                        
                      
                    </div>
                    <div class="border-t border-gray-200 pt-4">
                        <div class="flex justify-end">
                            <div class="w-full ">
                                <div class="flex justify-between py-2">
                                    <span class="text-gray-600">Subtotal (<%= sumOfQuantity %> items)</span>
                                    <span class="font-medium">$<%= (order.subTotal).toFixed(2) %></span>
                                </div>
                                <% if (order.discount !== null) { %>
                                    <div class="flex justify-between py-2">
                                        <span class="text-gray-600">Discount</span>
                                        <span class="font-medium">- $<%= (order.discount).toFixed(2) %></span>
                                    </div>
                                <% } %>
                                <div class="flex justify-between py-2">
                                    <span class="text-gray-600">Tax</span>
                                    <span class="font-medium">$<%= (order.tax).toFixed(2) %></span>
                                </div>
                                <div class="flex justify-between py-2">
                                    <span class="text-gray-600">Shipping</span>
                                    <span class="font-medium">$<%= (order.shipping).toFixed(2) %></span>
                                </div>
                                <div class="flex justify-between py-2 font-bold text-lg border-t border-gray-200 mt-2">
                                    <span>Total</span>
                                    <span>$<%= (order.grandTotal).toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

               
                
               
            </div>

            <div class="space-y-6 ">
                <div class="order-card p-6 border">
                    <h3 class="text-lg font-semibold mb-3 flex items-center">
                        <i data-feather="truck" class="mr-2"></i> Shipping Information
                    </h3>
                    <div class="space-y-2 text-gray-700">
                        <p><%= order.address.firstName %> <%= order.address.lastName %></p>
                        <p><%= order.address.address %></p>
                        <p><%= order.address.state %>, <%= order.address.city %> <%= (order.address.pincode !== "Not Applicable") ? order.address.pincode : ""%></p>
                        <p><%= order.address.country %></p>
                        <p ><strong>Phone:</strong> <%= order.address.mobileNo %></p>
                        <p><strong>Shipping Method:</strong> Standard Shipping</p>
                    </div>
                </div>
                <div class="order-card p-6 border">
                    <h3 class="text-lg font-semibold mb-3 flex items-center">
                        <i data-feather="credit-card" class="mr-2"></i> Payment Information
                    </h3>
                    <div class="space-y-2 text-gray-700">
                        <p><strong>Payment Method:</strong>
                            <% if (order.paymentId.paymentMethod === "Pay with Stripe" && (order.paymentId.status === "Pending"||order.paymentId.status === "Payment Failed" || order.paymentId.status === "Order Cancelled")) { %>
                                Pay with Credit / Debit Card
                              <% } else if(order.paymentId.paymentMethod === "Pay with Stripe" && order.paymentId.status === "Paid Successfully"){%>
                                Paid with Credit / Debit Card
                              <% } else if(order.paymentId.paymentMethod === "Pay with NovaWallet" && order.paymentId.status === "Pending") { %>
                                  Pay with NovaWallet
                              <% } else if(order.paymentId.paymentMethod === "Pay with NovaWallet" && order.paymentId.status === "Paid Successfully") { %>
                                Paid with NovaWallet</p>
                                <% } else { %>
                                    <%= order.paymentId.paymentMethod %>
                                 <% } %> </p>
                        <p><strong>Payment Status:</strong> <%= order.paymentId.status %></p>
                        <% if(order.paymentId.paymentDate === null){ %>
                            <p><strong>Payment Date:</strong> Not Paid Yet</p>
                        <% }else{ %>
                            <p><strong>Payment Date:</strong> <%= new Date(order.paymentId.paymentDate ).toLocaleDateString("en-IN", {
                                day: "numeric",
                                month: "short",
                                year: "numeric"
                            })%></p>
                         <% } %>
                        <p><strong>Total Amount to be Paid:</strong> $<%= order.paymentId.amountToBePaid %></p>
                        <p><strong>Total Paid:</strong> $<%= order.paymentId.amountPaid %></p>

                        <% if (order.paymentId.amountRefunded > 0 || order.paymentId.amountToBeRefunded > 0) { %>
                            <p><strong>Amount to be Refunded:</strong> $<%= order.paymentId.amountToBeRefunded.toFixed(2) %></p>
                            <p><strong>Amount Refunded:</strong> $<%= order.paymentId.amountRefunded.toFixed(2) %></p>
                        <% } %>
                    </div>
                </div>
            </div>
            
            
        </div>
        

        
    </div>

    <!-- Return Order Modal -->
<div id="returnModal" class="modal-overlay">
    <div class="modal-box">
      <h3 id="returnModalHeading">Return Order</h3>
      <p class="subtitle">Please select a reason for return</p>
  
      <form id="returnForm" method="post" action="" enctype="multipart/form-data">
        <!-- Reason -->
        <label for="returnReason">Reason</label>
        <select id="returnReason" name="returnReason" onchange="enableTextBox()">
          <option value="">Select reason</option>
          <option value="Damaged Product">Damaged Product</option>
          <option value="Wrong Item Delivered">Wrong Item Delivered</option>
          <option value="Size Issue">Size / Fit Issue</option>
          <option value="Quality Issue">Quality Not As Expected</option>
          <option value="Changed Mind">Changed My Mind</option>
          <option value="Other">Other</option>
        </select>
  
        <!-- Message -->
        <textarea id="returnMessage" class="hidden"  rows="4" placeholder="Please provide a reason ..." disabled></textarea>

        <label for="returnOrderMedia" >Upload an Image</label>
        <input type="file" name="returnOrderMedia" id="returnOrderMedia" accept="image/*" class="border border-gray-300 p-2 rounded-md w-full">
  
        <!-- Buttons -->
        <div class="modal-actions">
          <button id="cancelReturnBtn" type="button" class="btn-cancel rounded-lg" onclick="closeReturnModal()">Cancel</button>
          <button id="submitReturnBtn" type="submit" class="btn-submit rounded-lg font-bold text-black">Submit Return</button>
        </div>
      </form>
    </div>
  </div>
  
  <div id="processingRequestOverlay"
class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">

            <div class="bg-white rounded-xl shadow-lg px-8 py-6 my-[20rem] flex flex-col w-[30rem] mx-auto items-center">

                    <p class="text-lg font-semibold text-gray-800 mb-3">
                        Processing your Request. Please wait...
                    </p>
                    <p class="text-sm font-semibold text-gray-500 mb-3">
                        Do not refresh or close this page
                    </p>

                    <div class="flex space-x-2">
                        <span class="dot bg-green-500"></span>
                        <span class="dot bg-green-500"></span>
                        <span class="dot bg-green-500"></span>
                    </div>

            </div>

</div>
<script>
        
</script>
    <script src="/javascript/user-javascript/orderDetails.js"></script>
<%- include("../partials/user-side/footer.ejs")%>