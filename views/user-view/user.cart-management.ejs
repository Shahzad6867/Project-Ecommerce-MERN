<%- include("../partials/user-side/navbar.ejs",{title : "Novamart - My Cart"})%>
<div class="main-content">
    <div class="flex justify-between items-center mb-8">
     <h1 class="text-3xl font-bold">My Cart (<span id="cartHeadItemCountInCart" ><%= cartItemsCount[0]?.totalQuantity  || 0 %></span>)</h1>
    </div>

    <div class="w-full flex justify-between">
        <input type="text" id="serverMessage" value="<%= message ? message : null %>" hidden>
        <div id="cartItemsList" class="w-[65%] mr-2">
            <% let subTotal = 0 %>
            <% let offerPrice = 0 %>
            <% let itemsWithStock = 0 %>
            <% if (cartItems.length > 0) { %>
               <% let now = new Date() %>
             <% for( let i = 0; i < cartItems.length; i++ ) { %>
                <% if (!cartItems[i].productId.variants[cartItems[i].variant].isBlocked && !cartItems[i].categoryId.isDeleted && !cartItems[i].brandId.isDeleted) { %>
                <% if (cartItems[i].productId.variants[cartItems[i].variant].stockQuantity !== 0 && cartItems[i].productId.variants[cartItems[i].variant].stockStatus !== "Out of Stock") { %>
                    <%

                        
                        const price = cartItems[i].productId.variants[cartItems[i].variant].price
                        const quantity = cartItems[i].quantity

                        offerPrice = price
                        let productOfferPrice = null
                        let categoryOfferPrice = null

                        
                        const productOffer =
                        cartItems[i].productOfferId &&
                        cartItems[i].productOfferId.startDate <= now &&
                        cartItems[i].productOfferId.endDate >= now
                            ? cartItems[i].productOfferId
                            : null

                        const categoryOffer =
                        cartItems[i].categoryOfferId &&
                        cartItems[i].categoryOfferId.startDate <= now &&
                        cartItems[i].categoryOfferId.endDate >= now
                            ? cartItems[i].categoryOfferId
                            : null

                        
                        if (productOffer) {
                        if (productOffer.discountType === "percentage") {
                            productOfferPrice =
                            price - (price * productOffer.discountValue) / 100
                        } else if (productOffer.discountType === "flat") {
                            productOfferPrice =
                            price - productOffer.discountValue
                        }
                        }

                        
                        if (categoryOffer) {
                        if (categoryOffer.discountType === "percentage") {
                            const percentPrice =
                            price - (price * categoryOffer.discountValue) / 100

                            const maxPrice =
                            price - categoryOffer.maxDiscountAmount

                            categoryOfferPrice = Math.max(percentPrice, maxPrice)

                        } else if (categoryOffer.discountType === "flat") {
                            if (price > categoryOffer.productMinPrice) {
                            categoryOfferPrice =
                                price - categoryOffer.discountValue
                            }
                        }
                        }

                       
                        if (productOfferPrice !== null && categoryOfferPrice !== null) {
                        offerPrice = Math.min(productOfferPrice, categoryOfferPrice)

                        } else if (productOfferPrice !== null) {
                        offerPrice = productOfferPrice

                        } else if (categoryOfferPrice !== null) {
                        offerPrice = categoryOfferPrice
                        }

                       
                        subTotal += offerPrice * quantity
                     %>

                    
                
                <% itemsWithStock += cartItems[i].quantity %>
                <div id="cartItemInCart<%= cartItems[i]._id %>" class="bg-white rounded-lg border shadow-sm w-full  flex justify-between mb-2 p-6 ">
                    <div class="min-w-[20%] max-w-[20%] h-[20%]  border-2 border-black rounded-lg ">
                      <img src="<%= cartItems[i].productId.variants[cartItems[i].variant].productImages[0] %>" alt="" class="w-full height-[100%] rounded">
                    </div>
                    <div class="w-[78%]">
                     <div class="w-full flex justify-between">
                         <h1 class="font-bold text-2xl"><%= cartItems[i].productId.productName%></h1>
                        
                            <button type="button" class="text-gray-700 font-bold hover:text-black flex rounded-xl  bg-red-400 hover:bg-red-500 px-4 py-2 items-center text-sm" onclick="deleteItemInCartFromCart('<%- cartItems[i]._id%>','<%- cartItems[i].productId._id %>','<%- cartItems[i].variant %>')">
                                <i data-feather="trash-2" class="w-4 h-4 mr-1"></i> Remove
                            </button>
                    
                     </div>
                     <p>Color : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].color %></strong> | Size : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].size %></strong> | <span class="text-green-600"><%= cartItems[i].productId.variants[cartItems[i].variant].stockStatus %></span></p>
                     <div class="flex items-center gap-3 mt-1 mb-2">
                        <% if (offerPrice > 0 && offerPrice < cartItems[i].productId.variants[cartItems[i].variant].price ) { %>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= offerPrice.toFixed(2) %></span></p>
                            <p class="line-through text-gray-400 text-lg">$ <%= cartItems[i].productId.variants[cartItems[i].variant].price %></p>
                        <% } else {%>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= cartItems[i].productId.variants[cartItems[i].variant].price %></span></p>
                        <% } %>
                         
                           
                     </div>
                     <div class="w-full mt-1 flex justify-between items-center">
                         <div id="incDecQtyDiv<%= cartItems[i]._id  %>" class="flex items-center mt-2">
                             <button id="decQtyBtn<%= i %>" type="button" class="text-center rounded-full px-2 py-2 crop-btn mr-1 " onclick="decrementQuantity('<%= cartItems[i]._id %>','<%- cartItems[i].productId._id %>','<%- cartItems[i].variant %>')">
                                 <i data-feather="minus"></i>
                             </button> 
                             <input type="text" id="quantity<%= cartItems[i]._id %>" value="<%= cartItems[i].quantity %>" class="border border-black bg-white w-[3rem] px-2 text-xl rounded-full py-2 text-center" disabled>
                             <button id="incQtyBtn<%= i %>" type="button" type="button" class="text-center rounded-full px-2 py-2 ml-1 crop-btn " onclick="incrementQuantity('<%= cartItems[i]._id %>','<%- cartItems[i].productId._id %>','<%- cartItems[i].variant %>')">
                                 <i data-feather="plus"></i>
                             </button>
                         </div>
                     </div>
                    </div>
                 </div>
             <% } else {%>
                <div id="cartItemInCart<%= cartItems[i]._id %>" class="bg-white rounded-lg border shadow-sm w-full  flex justify-between mb-2 p-6 ">
                    <div class="min-w-[20%] max-w-[20%] h-[20%]  border-2 border-black rounded-lg ">
                      <img src="<%= cartItems[i].productId.variants[cartItems[i].variant].productImages[0] %>" alt="" class="w-full height-[100%] rounded">
                    </div>
                    <div class="w-[78%]">
                     <div class="w-full flex justify-between">
                         <h1 class="font-bold text-2xl"><%= cartItems[i].productId.productName%></h1>
                        
                            <button type="button" class="text-gray-700 font-bold hover:text-black flex rounded-xl  bg-red-400 hover:bg-red-500 px-4 py-2 items-center text-sm" onclick="deleteItemInCartFromCart('<%- cartItems[i]._id%>','<%- cartItems[i].productId._id %>','<%- cartItems[i].variant %>')">
                                <i data-feather="trash-2" class="w-4 h-4 mr-1"></i> Remove
                            </button>
                    
                     </div>
                     <p>Color : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].color %></strong> | Size : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].size %></strong> </p>
                     <div class="flex items-center gap-3 mt-1 mb-2">
                        <% if (offerPrice > 0 && offerPrice < cartItems[i].productId.variants[cartItems[i].variant].price ) { %>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= offerPrice.toFixed(2) %></span></p>
                            <p class="line-through text-gray-400 text-lg">$ <%= cartItems[i].productId.variants[cartItems[i].variant].price %></p>
                        <% } else {%>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= cartItems[i].productId.variants[cartItems[i].variant].price %></span></p>
                        <% } %>
                     </div>
                     <div class="w-full mt-1 flex justify-between items-center">
                         <div id="incDecQtyDiv<%= cartItems[i]._id %>" class="flex items-center mt-2">
                             <button  type="button" class="text-center w-full rounded-lg px-2 py-2 bg-red-400 font-bold text-black mr-1 " >
                                 Out of Stock
                             </button> 
                             
                         </div>
                     </div>
                    </div>
                 </div>
                <% } %>
             <% } else {%>
                <div id="cartItemInCart<%= cartItems[i]._id %>" class="bg-white rounded-lg border shadow-sm w-full  flex justify-between mb-2 p-6 ">
                    <div class="min-w-[20%] max-w-[20%] h-[20%]  border-2 border-black rounded-lg ">
                      <img src="<%= cartItems[i].productId.variants[cartItems[i].variant].productImages[0] %>" alt="" class="w-full height-[100%] rounded">
                    </div>
                    <div class="w-[78%]">
                     <div class="w-full flex justify-between">
                         <h1 class="font-bold text-2xl"><%= cartItems[i].productId.productName%></h1>
                        
                            <button type="button" class="text-gray-700 font-bold hover:text-black flex rounded-xl  bg-red-400 hover:bg-red-500 px-4 py-2 items-center text-sm" onclick="deleteItemInCartFromCart('<%- cartItems[i]._id%>','<%- cartItems[i].productId._id %>','<%- cartItems[i].variant %>')">
                                <i data-feather="trash-2" class="w-4 h-4 mr-1"></i> Remove
                            </button>
                    
                     </div>
                     <p>Color : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].color %></strong> | Size : <strong><%= cartItems[i].productId.variants[cartItems[i].variant].size %></strong> </p>
                     <div class="flex items-center gap-3 mt-1 mb-2">
                        <% if (offerPrice > 0 && offerPrice < cartItems[i].productId.variants[cartItems[i].variant].price ) { %>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= offerPrice.toFixed(2) %></span></p>
                            <p class="line-through text-gray-400 text-lg">$ <%= cartItems[i].productId.variants[cartItems[i].variant].price %></p>
                        <% } else {%>
                            <p class="text-3xl font-bold text-black" >$ <span id="price<%= cartItems[i]._id %><%= cartItems[i].variant %>" ><%= cartItems[i].productId.variants[cartItems[i].variant].price %></span></p>
                        <% } %>
                     </div>
                     <div class="w-full mt-1 flex justify-between items-center">
                         <div id="incDecQtyDiv<%= cartItems[i]._id %>" class="flex items-center mt-2">
                             <button  type="button" class="text-center w-full rounded-lg px-2 py-2 bg-red-400 font-bold text-black mr-1 " >
                                 Product Unavailable
                             </button> 
                             
                         </div>
                     </div>
                    </div>
                 </div>
                <% } %>
             <% } %>
            <% } else { %>
                <div class="bg-white rounded-lg border shadow-sm w-full min-h-[40%]  p-6">
                    <div class="border-2 w-full h-[196px]  rounded-lg">
                        <h1 class="text-2xl font-bold ml-[10rem] mt-[3.8rem]">Looks like you haven’t added anything yet !</h1>
                        <a href="/shop"><button type="button"  class="btn-primary ml-[22rem] flex font-bold rounded-full px-4 py-2 mt-1 "><i data-feather="shopping-cart" class="mr-2"></i>Shop Now</button></a>
                    </div>
                </div>
           <% } %>
            
        </div>
        
        <div class="w-[35%]">
            <div class="bg-white rounded-lg shadow-sm p-6">
                <h2 class="text-xl font-bold mb-4">Order Summary</h2>
                <% let isApplied = false %>
                <% let now = new Date() %>
                <% let discountedAmount = 0 %>
                <% if (cartItems[0]?.couponApplied !== null &&  subTotal >= cartItems[0]?.couponApplied.minAmount && cartItems[0]?.couponApplied.endDate >= now ) { %>
                   <% isApplied = true %>
                   <% if (cartItems[0]?.couponApplied.discountType === "percentage") { %>
                        <% discountedAmount = (subTotal * cartItems[0]?.couponApplied.discountValue) / 100 %>
                        <% if (discountedAmount > cartItems[0]?.couponApplied.maxDiscountAmount) { %>
                            <% discountedAmount = cartItems[0]?.couponApplied.maxDiscountAmount %>
                    <% } %>
                    <% } else { %>
                        <% discountedAmount = cartItems[0]?.couponApplied.discountValue %>
                   <% } %>
                   
                <% } %>
                <div id="appliedCouponDisplay" class="flex items-center mb-3 <%=  (!isApplied) ? 'hidden' : ''  %>">
                    <input id="appliedCouponName" type="text" value="<%= (isApplied) ? cartItems[0].couponApplied.name : ""  %>" class="w-[80%] px-4 py-2 bg-blue-600 text-white font-bold mr-2 rounded-md " disabled>
                    <button id="removeCouponBtn" type="button" class=" w-[20%] px-4 py-2 font-bold flex justify-center items-center  rounded-lg bg-red-400 hover:bg-red-500 " onclick="removeCoupon()" >
                    Remove
                    </button>
                </div>
                <div class="w-full">
                    <% if (coupons.length > 0) { %>
                        
                       
                           
                           
                                <div class="w-full offerBtn min-h-[5rem] p-2 rounded-md">
                                    <div  class="w-full flex flex-start items-center  mb-1 ">
                                        <i data-feather="gift" class="w-5 h-5 ml-2"></i>
                                        <h1 class="font-bold ml-1 ">Available Coupons</h1>
                                       
                                    </div>
                                   
                                    <% let couponCount = 0 %>
                                    <% for( let i = 0; i < userCoupons.length; i++ ) { %>
                                        
                                        <% if (userCoupons[i].endDate >= now) { %>
                                            <div class="divide-y divide-gray-200 w-full h-[5rem] rounded-md bg-white mt-1">
                                        
                                                <div class="w-full px-2 flex justify-between items-center h-[60%]">
                                                    <h1 class="font-bold text-black text-lg"><%= userCoupons[i].name %></h1>
                                                    <% if (cartItems[0]?.couponApplied !== null && userCoupons[i]._id.toString() === cartItems[0]?.couponApplied._id.toString() &&  (Number(subTotal) + (Number(subTotal) * 0.05)) >= cartItems[0]?.couponApplied.minAmount) { %>
                                                        <button id="appliedBtn<%= userCoupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 flex justify-between items-center text-black font-bold px-3 py-1"disabled>
                                                            <i data-feather="check" class=""></i>
                                                            Applied
                                                        </button>
                                                        <button id="applyBtn<%= userCoupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 text-black font-bold px-3 py-1 hover:bg-green-500 hidden" onclick="applyCoupon('<%= userCoupons[i]._id %>','<%= userCoupons[i].minAmount %>')">
                                                            Apply
                                                        </button>  
                                                    <% } else { %>
                                                        <button id="appliedBtn<%= userCoupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 flex justify-between items-center text-black font-bold px-3 py-1 hidden"disabled>
                                                            <i data-feather="check" class=""></i>
                                                            Applied
                                                        </button>
                                                        <button id="applyBtn<%= userCoupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 text-black font-bold px-3 py-1 hover:bg-green-500 " onclick="applyCoupon('<%= userCoupons[i]._id %>','<%= userCoupons[i].minAmount %>')">
                                                            Apply
                                                        </button>     
                                                    <% } %>
                                                    
                                                </div>
                                                <div class="w-full px-2">
                                                    <h1 class="font-bold text-black text-sm"><%= userCoupons[i].description %></h1>
                                                </div>
                                                
                                            </div>
                                        <% } else{%>
                                            <% couponCount++ %>
                                            <% } %>
                                    
                                    <% } %>
                                    <% for( let i = 0; i < coupons.length; i++ ) { %>
                                        
                                        <% if (coupons[i].endDate >= now) { %>
                                            <div class="divide-y divide-gray-200 w-full h-[5rem] rounded-md bg-white mt-1">
                                        
                                                <div class="w-full px-2 flex justify-between items-center h-[60%]">
                                                    <h1 class="font-bold text-black text-lg"><%= coupons[i].name %></h1>
                                                    <% if (cartItems[0]?.couponApplied !== null && coupons[i]._id.toString() === cartItems[0]?.couponApplied._id.toString() &&  (Number(subTotal) + (Number(subTotal) * 0.05)) >= cartItems[0]?.couponApplied.minAmount) { %>
                                                        <button id="appliedBtn<%= coupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 flex justify-between items-center text-black font-bold px-3 py-1 "  disabled>
                                                            <i data-feather="check" class=""></i>
                                                            Applied
                                                        </button>
                                                        <button id="applyBtn<%= coupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 text-black font-bold px-3 py-1 hover:bg-green-500 hidden" onclick="applyCoupon('<%= coupons[i]._id %>','<%= coupons[i].minAmount %>')">
                                                            Apply
                                                        </button> 
                                                    <% } else { %>
                                                        <button id="appliedBtn<%= coupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 flex justify-between items-center text-black font-bold px-3 py-1 hidden"  disabled>
                                                            <i data-feather="check" class=""></i>
                                                            Applied
                                                        </button>
                                                        <button id="applyBtn<%= coupons[i]._id %>" type="button" class="mr-2 rounded-lg bg-green-400 text-black font-bold px-3 py-1 hover:bg-green-500" onclick="applyCoupon('<%= coupons[i]._id %>','<%= coupons[i].minAmount %>')">
                                                            Apply
                                                        </button>     
                                                    <% } %>
                                                    
                                                </div>
                                                <div class="w-full px-2">
                                                    <h1 class="font-bold text-black text-sm"><%= coupons[i].description %></h1>
                                                </div>
                                                
                                            </div>
                                        <% } else{%>
                                            <% couponCount++ %>
                                            <% } %>
                                    
                                    <% } %>
                                    <% if (couponCount === (coupons.length + userCoupons.length)) { %>
                                        <div class="flex justify-center items-center w-full h-[3rem] rounded-md bg-white mt-1">
                                             <h1 class="text-black font-bold text-xl">No Eligible Coupons</h1>
                                        </div>
                                    <% } %>
                                </div>
                           
                            
                        <% } %>
                        
                
                </div>
                <div class="space-y-4 mt-2">
                    <div class="flex justify-between">
                        <span class="text-gray-600 font-bold">Subtotal (<span id="subTotalItemsInCart"><%= itemsWithStock || 0%></span> items)</span>
                        <span  class="font-bold">$ <span id="subTotalInCart"><%= subTotal.toFixed(2) %></span></span>
                        <% subTotal = (isApplied === true) ? (subTotal - discountedAmount).toFixed(2) : subTotal.toFixed(2) %>
                    </div>
               
                        <div id="discountDiv" class="flex justify-between <%= (!isApplied) ? "hidden" : "" %>">
                            <span class="text-gray-600 font-bold">Discount </span>
                            <span  class="font-bold">$ <span id="discountedValue"><%=  discountedAmount?.toFixed(2) || 0 %></span></span>
                        </div>
                
                    <div class="flex justify-between">
                        <span class="text-gray-600 font-bold">Tax</span>
                        <% let tax = (subTotal * 0.05).toFixed(2) %>
                        <span  class="font-bold">$ <span id="tax"><%= tax %></span></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-600 font-bold">Shipping</span>
                        <% let shipping = (cartItems.length === 0) ? Number(0) : Number(10) %>
                        <span class="font-bold">$<%= shipping.toFixed(2) %></span>
                    </div>
                    
                    
                    <div class="border-t border-gray-200 pt-4">
                        <div class="flex justify-between">
                            <span class="text-lg font-bold">Total</span>
                            <% let grandTotal = (Number(subTotal) + Number(tax) + Number(shipping)).toFixed(2) %>
                            <span class="text-lg font-bold">$ <span id="grandTotal" ><%= grandTotal %></span></span>
                        </div>
                    </div>
                </div>
                <input type="text" id="isCouponApplied" value="<%= isApplied %>" hidden>
                <button id="checkoutBtnInCart" type="button" class="w-full mt-6 py-3 px-4 btn-primary font-bold rounded-lg flex items-center justify-center">
                    <span>Proceed to Checkout</span>
                    <i data-feather="arrow-right" class="w-5 h-5 ml-2"></i>
                </button>
                
                
            </div>
            
            <div class="bg-white rounded-lg shadow-sm p-6 mt-6">
                <h2 class="text-lg font-bold mb-4">Payment Methods</h2>
                <div class="flex items-center space-x-4">
                    <img src="/images/visa.png" class="h-4" alt="Visa">
                    <img src="/images/mastercard.svg" class="h-6" alt="Mastercard">
                    <img src="/images/american-express.svg" class="h-4" alt="American Express">
                    
                    
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function applyCoupon(couponId,minAmount){
        const grandTotalElement = document.getElementById("grandTotal")
        const subTotal = Number(document.getElementById("subTotalInCart").innerText)
        const taxElement = document.getElementById("tax")
        const discountDiv = document.getElementById("discountDiv")
        const discountValue = document.getElementById("discountedValue")
        if(grandTotal < Number(minAmount)){
            iziToast.info({
                title : "Coupon",
                message : `The minimum amount to apply this coupon is $${minAmount}`,
                position : "topRight"
            })
            event.preventDefault()
            return
        }
        fetch(`/cart/apply-coupon/${couponId}`,{method : "PATCH"})
        .then(res => res.json())
        .then(data => {
            if(data.message === "Done"){
                let discountedAmount = 0
                 if (data.coupon.discountType === "percentage") { 
                         discountedAmount = (subTotal * data.coupon.discountValue) / 100
                         if (discountedAmount > data.coupon.maxDiscountAmount) { 
                            discountedAmount = data.coupon.maxDiscountAmount
                          } 
                     } else { 
                         discountedAmount = data.coupon.discountValue
                } 
                const tax = ((subTotal - discountedAmount) * 0.05)
                const shipping = 10
               taxElement.innerText =  tax.toFixed(2)
               grandTotalElement.innerText = ((subTotal - discountedAmount) + tax + shipping).toFixed(2)
               discountDiv.classList.remove("hidden")
               discountValue.innerText = discountedAmount.toFixed(2)
               document.getElementById(`applyBtn${data.coupon._id}`).classList.add("hidden")
               document.getElementById(`appliedBtn${data.coupon._id}`).classList.remove("hidden")
               if(data.olderCoupon !== null){
                document.getElementById(`applyBtn${data.olderCoupon}`).classList.remove("hidden")
                document.getElementById(`appliedBtn${data.olderCoupon}`).classList.add("hidden")
               }else{
                document.getElementById("appliedCouponDisplay").classList.remove("hidden")
               }
               document.getElementById("appliedCouponName").value = data.coupon.name

            }
        })
        .catch(error => { 
            iziToast.error({
                title : "Error",
                message : error.message,
                position : "topRight"
            })
        })
    }
    function removeCoupon(){
        fetch(`/cart/remove-coupon`,{method : "PATCH"})
        .then(res => res.json())
        .then(data => {
            if(data.message === "Done"){
                const grandTotalElement = document.getElementById("grandTotal")
                const subTotal = Number(document.getElementById("subTotalInCart").innerText)
                const taxElement = document.getElementById("tax")
                const discountDiv = document.getElementById("discountDiv")
                const discountValue = document.getElementById("discountedValue")
                
                const tax = (subTotal * 0.05)
                const shipping = 10
               taxElement.innerText =  tax.toFixed(2)
               grandTotalElement.innerText = (subTotal + tax + shipping).toFixed(2)
               discountDiv.classList.add("hidden")
               discountValue.innerText = 0.00
               document.getElementById(`applyBtn${data.coupon.couponApplied}`).classList.remove("hidden")
               document.getElementById(`appliedBtn${data.coupon.couponApplied}`).classList.add("hidden")
                document.getElementById("appliedCouponDisplay").classList.add("hidden")
               document.getElementById("appliedCouponName").value = ""
            }
        })
        .catch(error => { 
            iziToast.error({
                title : "Error",
                message : error.message,
                position : "topRight"
            })
        })
    }
</script>
