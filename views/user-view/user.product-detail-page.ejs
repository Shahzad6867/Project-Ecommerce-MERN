<%- include("../partials/user-side/navbar.ejs",{title : "Novamart - Product Details"})%>
<input id="isInProductPage" type="text" value="Yes" hidden>
  <!-- Product Section -->
  <main class="max-w-7xl mx-auto py-8 px-6">
    <div class="flex items-center " style="margin-bottom: 12px;">
      <a href="/" class="border border-gray-700 rounded-full px-2 py-2">
          
            <i data-feather="arrow-left" class="w-6 h-6 "></i>
            
      </a>
      <span class="ml-2">Back to Home</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <!-- Left - Image -->
      <div>
    
        <div id="imageZoom" style=" 
          --url : url(<%= product.variants[variant].productImages[0] %>);
          --zoom-x : 0%; --zoom-y : 0%;
          --display : none;
         " class="shadow-lg">
         
          <button  type="button" class="absolute top-2 right-2 bg-white rounded-full z-50 border p-2 shadow-md "  onclick="removeFromWishlist('<%= product._id %>','<%= Number(variant) %>')">
            <i data-feather="heart" class="w-6 h-6" fill="#FF2400" stroke="#FF2400"></i>
        </button>
        <% if (user) { %>
          <button id="addWishBtn<%= product._id %><%= variant %>" type="button" class="absolute top-2 right-2 bg-white border rounded-full z-50 p-2 shadow-md  <%= (wishlistItems.find(item => String(item.productId) === String(product._id) && Number(item.variant) === Number(variant))) ? 'hidden' : '' %>" onclick="addToWishlist(this,'<%= product._id %>','<%= Number(variant) %>')">
            <i  data-feather="heart" class="w-6 h-6" ></i>
        </button>
        <% } else { %>
          <button id="addWishBtn<%= product._id %><%= variant %>" type="button" class="absolute top-2 right-2 bg-white border rounded-full z-50 p-2 shadow-md  <%= (wishlistItems.find(item => String(item.productId) === String(product._id) && Number(item.variant) === Number(variant))) ? 'hidden' : '' %>" onclick="getUserToLogin()">
            <i  data-feather="heart" class="w-6 h-6" ></i>
        </button>
        <% } %>
         
          <img id="mainImage" src="<%= product.variants[variant].productImages[0] %>" alt="Bag" class="  rounded-lg border shadow-sm">
        </div>
        <div class="w-[500px] flex flex-wrap mt-4">
          <% for( let i = 0; i < product.variants[variant].productImages.length; i++ ) { %>
           
          <img src="<%= product.variants[variant].productImages[i] %>" class="thumbnail w-16 h-16 border rounded-md cursor-pointer hover:ring-2 hover:ring-emerald-500 mr-1 mb-1" />
           
          <% } %>
          
        </div>
      </div>

      <!-- Right - Details -->
      <div>
        <h2 class="text-2xl font-semibold leading-snug">
          <%= product.productName %>
        </h2>
          <% if (product.variants[variant].stockQuantity === 0 || product.variants[variant].stockStatus === "Out of Stock") { %>
            <span class="text-red-500 text-sm">Out of Stock</span>
          <% } else {%>
            <span class="text-green-500 text-sm">In Stock</span>
            <% } %>
       </p>
        <div class="flex items-center gap-3 mt-3">
            <p class="text-sm font-medium text-black"><%= product.description %></p>
          </div>
          <div class="flex items-center gap-3 mt-3"><form id="colorForm" class="flex gap-3 flex-wrap">
            <form>
              <% if (product.variants.length > 1) { %>
              <% for( let i = 0; i < product.variants.length; i++ ) { %>
                <% if (variant == i) { %>
                  <label class="cursor-pointer">
                    <input type="radio" name="color" value="<%= product.variants[i].size %>" class="hidden peer" checked>
                    <div class="border border-gray-300 px-5 py-2 rounded-lg peer-checked:bg-black peer-checked:text-white transition">
                      <%= product.variants[i].size %>
                    </div>
                  </label>
                <% }else{ %>
                  <label class="cursor-pointer">
                    <input type="radio" name="color" value="<%= product.variants[i].size %>" class="hidden peer" >
                    <a href="/product?id=<%= product._id %>&variant=<%= i %>">
                      <div class="border border-gray-300 px-5 py-2 rounded-lg peer-checked:bg-black peer-checked:text-white transition">
                        <%= product.variants[i].size %>
                      </div>
                    </a>
                  </label>
                  <% }%>
            
             <% } %>
            <% }else{ %>
              <div class="border border-gray-500 px-5 py-2 rounded-lg peer-checked:bg-black peer-checked:text-white transition">
                <%= product.variants[variant].size %>
              </div>
              <%}%>
          </form>
          </div>
          
        <div class="flex items-center gap-3 mt-3">
         
                  <% let now = new Date() %>
                  <%
                  /* ================================
                     Base values
                  ================================ */
                
                  const price = product.variants[variant].price
                  const productOffer = product.variants[variant].productOfferId
                  const categoryOffer = product.categoryOfferId
                  
                  let offerPrice = price
                  let productOfferPrice = null
                  let categoryOfferPrice = null
                  
                  /* ================================
                     Check offer activeness
                  ================================ */
                  const isProductOfferActive =
                    productOffer &&
                    productOffer.startDate <= now &&
                    productOffer.endDate >= now
                  
                  const isCategoryOfferActive =
                    categoryOffer &&
                    categoryOffer.startDate <= now &&
                    categoryOffer.endDate >= now
                  
                  /* ================================
                     Calculate product offer price
                  ================================ */
                  if (isProductOfferActive) {
                    if (productOffer.discountType === "percentage") {
                      productOfferPrice =
                        price - (price * productOffer.discountValue) / 100
                    } else if (productOffer.discountType === "flat") {
                      productOfferPrice =
                        price - productOffer.discountValue
                    }
                  }
                  
                  /* ================================
                     Calculate category offer price
                  ================================ */
                  if (isCategoryOfferActive) {
                    if (categoryOffer.discountType === "percentage") {
                      const percentPrice =
                        price - (price * categoryOffer.discountValue) / 100
                  
                      const maxPrice =
                        price - categoryOffer.maxDiscountAmount
                  
                      // Apply max discount cap
                      categoryOfferPrice = Math.max(percentPrice, maxPrice)
                  
                    } else if (categoryOffer.discountType === "flat") {
                      if (price > categoryOffer.productMinPrice) {
                        categoryOfferPrice =
                          price - categoryOffer.discountValue
                      }
                    }
                  }
                  
                  /* ================================
                     Decide final offer price
                  ================================ */
                  if (productOfferPrice !== null && categoryOfferPrice !== null) {
                    // Both active → choose better discount
                    offerPrice = Math.min(productOfferPrice, categoryOfferPrice)
                  
                  } else if (productOfferPrice !== null) {
                    // Only product offer active
                    offerPrice = productOfferPrice
                  
                  } else if (categoryOfferPrice !== null) {
                    // Only category offer active
                    offerPrice = categoryOfferPrice
                  }
                  // Else → no active offer, original price remains
                  %>
            <% if (offerPrice > 0 && offerPrice < product.variants[variant].price ) { %>
                <p class="text-3xl font-bold text-black">$ <span id="price<%= product._id  %><%= variant %>" ><%= offerPrice.toFixed(2) %></span></p>
                <p class="line-through text-gray-400 text-lg">$ <%= (product.variants[variant].price).toFixed(2) %></p>
                <p class="text-blue-600 text-md font-medium"><%= (((product.variants[variant].price - offerPrice) / product.variants[variant].price) * 100).toFixed(0) %>% off</p> 
            <% } else {%>
                <p class="text-3xl font-bold text-black">$ <span id="price<%= product._id  %><%= variant %>" ><%= (product.variants[variant].price).toFixed(2) %></span></p>
            <% } %>
          
          
        </div>
        <div class=" items-center gap-3 mt-3">
            <p class="text-gray-600 flex"><span class="iconify text-green-400" data-icon="charm-tick" style="width: 20;height: 20;"></span>&ensp;Free Delivery</p>
            <p class="text-gray-600 flex"><span class="iconify text-green-400" data-icon="charm-tick" style="width: 20;height: 20;"></span>&ensp;Secure Payment</p>
          </div>
        <div class="flex items-center gap-3 mt-4">
          <% if (product.variants[variant].stockQuantity !== 0 || product.variants[variant].stockStatus !== "Out of Stock") { %>
        
            <% if (isProductInCart && !product.variants[variant].isBlocked && !product.categoryId.isDeleted && !product.brandId.isDeleted) { %>
              <div id="incDecQtyDiv" class="flex items-center mt-2">
                <button id="decQtyBtn" type="button" class="text-center rounded-full px-2 py-2 crop-btn mr-1 " onclick="decrementQuantityFromProductPage('<%- variant %>','<%- product._id %>')">
                    <i data-feather="minus"></i>
                </button> 
                <input type="text" id="quantity<%= product._id %><%= variant %>" value="<%= isProductInCart.quantity %>" class="border bg-white w-[3rem] px-2 text-xl rounded-full py-2 text-center" disabled>
                <button id="incQtyBtn" type="button" class="text-center rounded-full px-2 py-2 ml-1 crop-btn " onclick="incrementQuantityFromProductPage('<%- variant %>','<%- product._id %>')">
                    <i data-feather="plus"></i>
                </button>
              </div>
            <% } else {%>
              <div id="incDecQtyDiv" class="flex items-center mt-2 hidden">
                <button id="decQtyBtn" type="button" class="text-center rounded-full px-2 py-2 crop-btn mr-1 " onclick="decrementQuantityFromProductPage('<%- variant %>','<%- product._id %>')">
                    <i data-feather="minus"></i>
                </button> 
                <input type="text" id="quantity<%= product._id %><%= variant %>" value="1" class="border bg-white w-[3rem] px-2 text-xl rounded-full py-2 text-center" disabled>
                <button id="incQtyBtn" type="button" class="text-center rounded-full px-2 py-2 ml-1 crop-btn " onclick="incrementQuantityFromProductPage('<%- variant %>','<%- product._id %>')">
                    <i data-feather="plus"></i>
                </button>
              </div>
             <% } %>
            <% } %>
        
        </div>
        <div class="flex items-center gap-3 mt-4">
           <% if (product.variants[variant].stockQuantity === 0 || product.variants[variant].stockStatus === "Out of Stock") { %>
            <button id="buyNow" class="bg-gray-200  text-gray-400 font-extrabold  px-3 py-3 rounded-lg shadow" disabled>Buy Now</button>
            <button id="addToCartBtn<%= product._id %><%= variant %>" class="bg-gray-200  flex text-gray-400 font-semibold items-center px-6 py-2 rounded-lg shadow" onclick="addToCartInitiallyFromProductPage(this,'<%= variant %>','<%= product._id %>')" disabled>
                <span class="iconify mr-1" data-icon="solar-cart-3-linear" style="width: 32;height: 32;"></span>Add to Cart</button>
           <% } else {%>
            <% if (isProductInCart) { %>
              <% if (!product.variants[variant].isBlocked && !product.categoryId.isDeleted && !product.brandId.isDeleted) { %>
                <button id="buyNow" class="bg-yellow-400 hover:bg-yellow-300 text-gray-700 font-extrabold  px-3 py-3 rounded-lg shadow" onclick="buyNow('<%= product._id %>','<%= variant %>')">Buy Now</button>
                <button id="addToCartBtn<%= product._id %><%= variant %>" class="bg-yellow-400 flex justify-between items-center hover:bg-yellow-300 text-gray-700 font-semibold  px-3 py-2 rounded-lg shadow hidden" onclick="addToCartInitiallyFromProductPage(this,'<%= variant %>','<%= product._id %>')">
                    <span class="iconify mr-1" data-icon="solar-cart-3-linear" style="width: 32;height: 32;" ></span>Add to Cart</button>
              <% } else { %>
                <button type="button" class="bg-red-400  text-gray-700 font-extrabold  px-3 py-3 rounded-lg shadow" disabled>Product Unavailable</button>
              <% } %>
              
            <% } else { %>
              <% if (user) { %>
                <% if (!product.variants[variant].isBlocked && !product.categoryId.isDeleted && !product.brandId.isDeleted) { %>
                  <button id="buyNow" class="bg-yellow-400 hover:bg-yellow-300 text-gray-700 font-extrabold  px-3 py-3 rounded-lg shadow" onclick="buyNow('<%= product._id %>','<%= variant %>')">Buy Now</button>
                  <button id="addToCartBtn<%= product._id %><%= variant %>" class="bg-yellow-400 flex justify-between items-center hover:bg-yellow-300 text-gray-700 font-semibold  px-3 py-2 rounded-lg shadow " onclick="addToCartInitiallyFromProductPage(this,'<%= variant %>','<%= product._id %>')">
                    <span class="iconify mr-1" data-icon="solar-cart-3-linear" style="width: 32;height: 32;" ></span>Add to Cart</button>
                <% } else { %>
                  <button type="button" class="bg-red-400  text-gray-700 font-extrabold  px-3 py-3 rounded-lg shadow" disabled>Product Unavailable</button>
                <% } %>
                
              <% } else { %>
                <button id="buyNow" class="bg-yellow-400 hover:bg-yellow-300 text-gray-700 font-extrabold  px-3 py-3 rounded-lg shadow">Buy Now</button>
                <button id="addToCartBtn<%= product._id %><%= variant %>" class="bg-yellow-400 flex justify-between items-center hover:bg-yellow-300 text-gray-700 font-semibold  px-3 py-2 rounded-lg shadow " onclick="getUserToLogin()">
                  <span class="iconify mr-1" data-icon="solar-cart-3-linear" style="width: 32;height: 32;" ></span>Add to Cart</button>
              <% } %>
             
              <% } %>
            <% } %>
        </div>
        
      </div>

    </div>

    <!-- Related Products -->
    <% if (relatedProduct.length > 1) { %>
    <section class="mt-14">
      <h3 class="text-xl font-semibold mb-5">Related Products</h3>
      <div  class="scroll-x-div ">
        <!-- Card -->
         <% for( let i = 0; i < relatedProduct.length; i++ ) { %>
         <% for( let j = 0; j < relatedProduct[i].variants.length; j++ ) { %>
            <% let now = new Date() %>
                <% if ( relatedProduct[i].variants[j].stockQuantity !== 0 && relatedProduct[i].variants[j].stockStatus !== "Out of Stock" ) { %>
           <% if (!relatedProduct[i].isDeleted) { %>
            <%
            /* ================================
               Base values
            ================================ */
          
            const price = relatedProduct[i].variants[j].price
            const productOffer = relatedProduct[i].variants[j].productOfferId
            const categoryOffer = relatedProduct[i].categoryOfferId
            
            let offerPrice = price
            let productOfferPrice = null
            let categoryOfferPrice = null
            
            /* ================================
               Check offer activeness
            ================================ */
            const isProductOfferActive =
              productOffer &&
              productOffer.startDate <= now &&
              productOffer.endDate >= now
            
            const isCategoryOfferActive =
              categoryOffer &&
              categoryOffer.startDate <= now &&
              categoryOffer.endDate >= now
            
            /* ================================
               Calculate product offer price
            ================================ */
            if (isProductOfferActive) {
              if (productOffer.discountType === "percentage") {
                productOfferPrice =
                  price - (price * productOffer.discountValue) / 100
              } else if (productOffer.discountType === "flat") {
                productOfferPrice =
                  price - productOffer.discountValue
              }
            }
            
            /* ================================
               Calculate category offer price
            ================================ */
            if (isCategoryOfferActive) {
              if (categoryOffer.discountType === "percentage") {
                const percentPrice =
                  price - (price * categoryOffer.discountValue) / 100
            
                const maxPrice =
                  price - categoryOffer.maxDiscountAmount
            
                // Apply max discount cap
                categoryOfferPrice = Math.max(percentPrice, maxPrice)
            
              } else if (categoryOffer.discountType === "flat") {
                if (price > categoryOffer.productMinPrice) {
                  categoryOfferPrice =
                    price - categoryOffer.discountValue
                }
              }
            }
            
            /* ================================
               Decide final offer price
            ================================ */
            if (productOfferPrice !== null && categoryOfferPrice !== null) {
              // Both active → choose better discount
              offerPrice = Math.min(productOfferPrice, categoryOfferPrice)
            
            } else if (productOfferPrice !== null) {
              // Only product offer active
              offerPrice = productOfferPrice
            
            } else if (categoryOfferPrice !== null) {
              // Only category offer active
              offerPrice = categoryOfferPrice
            }
            // Else → no active offer, original price remains
            %>
            <% if (String(relatedProduct[i]._id) !== String(product._id)) { %>
               
                <div class="product-card mr-2 bg-white rounded-lg shadow-sm p-4 transition-all w-[240px] flex-shrink-0">
                  <div class="h-40 mb-3 relative">
                      <img src="<%= relatedProduct[i].variants[j].productImages[0] %>" alt="Product" class="w-full h-full object-contain">
                      <button  type="button" class="absolute top-2 right-2 bg-white rounded-full z-50 border p-2 shadow-md "  onclick="removeFromWishlist('<%= relatedProduct[i]._id %>','<%= j %>')">
                        <i data-feather="heart" class="w-4 h-4" fill="#FF2400" stroke="#FF2400"></i>
                    </button>
                    <% if (user) { %>
                      <button id="addWishBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="absolute top-2 right-2 bg-white border rounded-full z-50 p-2 shadow-md  <%= (wishlistItems.find(item => String(item.productId) === String(relatedProduct[i]._id) && item.variant === j )) ? 'hidden' : '' %>" onclick="addToWishlist(this,'<%= relatedProduct[i]._id %>','<%= j %>')">
                        <i  data-feather="heart" class="w-4 h-4" ></i>
                    </button>
                    <% } else { %>
                      <button id="addWishBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="absolute top-2 right-2 bg-white border rounded-full z-50 p-2 shadow-md  <%= (wishlistItems.find(item => String(item.productId) === String(relatedProduct[i]._id) && item.variant === j )) ? 'hidden' : '' %>" onclick="getUserToLogin()">
                        <i  data-feather="heart" class="w-4 h-4" ></i>
                    </button>
                    <% } %>
                    
                      <a href="/product?id=<%= relatedProduct[i]._id %>&variant=<%= j%>">
                          <button class="absolute top-12 right-2 bg-white rounded-full p-2 shadow-md hover:bg-gray-100">
                              <i data-feather="eye" class="w-4 h-4"></i>
                          </button>
                      </a>
                  </div>
                  <h3 class="font-medium text-sm mb-1 truncate"><%= relatedProduct[i].productName  %></h3>
                  <div class="flex items-center mb-1">
                      <div class="text-yellow-400 flex">
                          <i data-feather="star" class="w-4 h-4 fill-current"></i>
                          <i data-feather="star" class="w-4 h-4 fill-current"></i>
                          <i data-feather="star" class="w-4 h-4 fill-current"></i>
                          <i data-feather="star" class="w-4 h-4 fill-current"></i>
                          <i data-feather="star" class="w-4 h-4 fill-current"></i>
                      </div>
                      <span class="text-gray-500 text-xs ml-1">(4,567)</span>
                  </div>
                  <div class="flex items-center mb-2">
                      <span class="font-regular text-xs">Brand : <a href="#" class="text-blue-700"><%= (relatedProduct[i].brandId.brandName) %></a></span>
                  </div>
                  <div class="flex items-center mb-2">
                      <span class="font-regular text-gray-400 text-xs">Size : <a href="#" ><%= (relatedProduct[i].variants[j].size) %></a></span>
                  </div>
                  <div class="flex items-center mb-2">
                    <% if (offerPrice > 0 && offerPrice < relatedProduct[i].variants[j].price ) { %>
                        <span class="font-bold text-lg">$ <span id="price<%= relatedProduct[i]._id  %><%= j %>" ><%= offerPrice.toFixed(2) %></span></span>
                        <span class="text-gray-500 text-sm line-through ml-2">$<%= (relatedProduct[i].variants[j].price).toFixed(2)  %></span>
                        <span class="text-green-600 text-xs font-medium ml-2"><%= (((relatedProduct[i].variants[j].price - offerPrice) / relatedProduct[i].variants[j].price) * 100).toFixed(0) %>% off</span>   
                    <% } else {%>
                        <span class="font-bold text-lg">$ <span id="price<%= relatedProduct[i]._id %><%= j %>"><%= (relatedProduct[i].variants[j].price).toFixed(2) %></span></span>
                    <% } %>
                  </div>
                  <% if (user) { %>
                    <% if (!relatedProduct[i].variants[j].isBlocked && !relatedProduct[i].categoryId.isDeleted && !relatedProduct[i].brandId.isDeleted) { %>
                                <% if (isProductInCart) { %>
                                <div class="flex  justify-between ">
                                <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-[0%] bg-yellow-400 hover:bg-yellow-500 text-gray-900  rounded-md font-medium text-sm flex items-center justify-center" onclick="addToCartInitially(this,'<%- i %>','<%- j %>','<%- relatedProduct[i]._id %>','<%- j %>')">
                                    <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> 
                                </button>
                                    <div id="incDecQtyDiv<%= relatedProduct[i]._id %><%= j %>" class="flex items-center justify-between w-[100%]  rounded-lg   border border-black w-full ">
                                        <button id="decQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full bg-yellow-400 hover:bg-yellow-300 py-1 rounded-l-lg"  onclick="decrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                            <i data-feather="minus"></i>
                                        </button> 
                                        <input type="text" id="quantity<%= relatedProduct[i]._id %><%= j %>" value="<%= isProductInCart.quantity %>" class=" w-[5rem] px-2 text-xl bg-white font-bold py-[0.22rem] border-black-x-sides text-center" >
                                        <button id="incQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full py-1 bg-yellow-400 hover:bg-yellow-300 rounded-r-lg"  onclick="incrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                            <i data-feather="plus"></i>
                                        </button>
                                    </div>
                                </div>
                        <% } else {%>
                            <!-- <a  href="/home/cart?productId=&variant=&quantity=1"> -->
                                <div id="incDecQtyDiv<%= relatedProduct[i]._id %><%= j %>" class="flex items-center justify-between w-[100%] bg-yellow-400  border border-black rounded-lg hidden">
                                    <button id="decQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full bg-yellow-400 hover:bg-yellow-300 py-1 rounded-l-lg" onclick="decrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                        <i data-feather="minus"></i>
                                    </button> 
                                    <input type="text" id="quantity<%= relatedProduct[i]._id %><%= j %>" value="1" class=" w-[5rem] bg-white px-2 text-xl  py-[0.22rem] border-black-x-sides text-center" >
                                    <button id="incQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full py-1 bg-yellow-400 hover:bg-yellow-300 rounded-r-lg" onclick="incrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                        <i data-feather="plus"></i>
                                    </button>
                                </div>
                                <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-full bg-yellow-400 hover:bg-yellow-500 text-gray-900 py-2 rounded-md font-medium text-sm flex items-center justify-center" onclick="addToCartInitially(this,'<%- i %>','<%- j %>','<%- relatedProduct[i]._id %>')">
                                    <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> Add to Cart
                                </button>
                        <% } %>
                    <% } else { %>
                          <button type="button" class="w-full bg-red-400 text-gray-900 py-2 rounded-md font-bold text-sm flex items-center justify-center" disabled>
                            Product Unavailable
                      </button>
                    <% } %>
                    <% } else { %>
                          <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-full bg-yellow-400 hover:bg-yellow-500 text-gray-900 py-2 rounded-md font-medium text-sm flex items-center justify-center" onclick="getUserToLogin()">
                            <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> Add to Cart
                        </button>
                    <% } %>
                        
              </div>  
                          
              <% } else {%>
                <% if (variant != j) { %>
                  <div class="product-card bg-white mr-2 rounded-lg shadow-sm p-4 transition-all w-[240px] flex-shrink-0 ">
                    <div class="h-40 mb-3 relative">
                        <img src="<%= relatedProduct[i].variants[j].productImages[0] %>" alt="Product" class="w-full h-full object-contain">
                        <button  type="button" class="absolute top-2 right-2 bg-white rounded-full z-50 border p-2 shadow-md "  onclick="removeFromWishlist('<%= relatedProduct[i]._id %>','<%= j %>')">
                            <i data-feather="heart" class="w-4 h-4" fill="#FF2400" stroke="#FF2400"></i>
                        </button>
                         <button id="addWishBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="absolute top-2 right-2 bg-white border rounded-full z-50 p-2 shadow-md  <%= (wishlistItems.find(item => String(item.productId) === String(relatedProduct[i]._id) && item.variant === j )) ? 'hidden' : '' %>" onclick="addToWishlist(this,'<%= relatedProduct[i]._id %>','<%= j %>')">
                            <i  data-feather="heart" class="w-4 h-4" ></i>
                        </button>
                        <a href="/product?id=<%= relatedProduct[i]._id %>&variant=<%= j%>">
                            <button class="absolute top-12 right-2 bg-white rounded-full p-2 shadow-md hover:bg-gray-100">
                                <i data-feather="eye" class="w-4 h-4"></i>
                            </button>
                        </a>
                    </div>
                    <h3 class="font-medium text-sm mb-1 truncate"><%= relatedProduct[i].productName  %></h3>
                    <div class="flex items-center mb-1">
                        <div class="text-yellow-400 flex">
                            <i data-feather="star" class="w-4 h-4 fill-current"></i>
                            <i data-feather="star" class="w-4 h-4 fill-current"></i>
                            <i data-feather="star" class="w-4 h-4 fill-current"></i>
                            <i data-feather="star" class="w-4 h-4 fill-current"></i>
                            <i data-feather="star" class="w-4 h-4 fill-current"></i>
                        </div>
                        <span class="text-gray-500 text-xs ml-1">(4,567)</span>
                    </div>
                    <div class="flex items-center mb-2">
                        <span class="font-regular text-xs">Brand : <a href="#" class="text-blue-700"><%= (relatedProduct[i].brandId.brandName) %></a></span>
                    </div>
                    <div class="flex items-center mb-2">
                        <span class="font-regular text-gray-400 text-xs">Size : <a href="#" ><%= (relatedProduct[i].variants[j].size) %></a></span>
                    </div>
                    <div class="flex items-center mb-2">
                        
                        <% if (offerPrice > 0 && offerPrice < relatedProduct[i].variants[j].price ) { %>
                            <span class="font-bold text-lg">$ <span id="price<%= relatedProduct[i]._id  %><%= j %>" ><%= offerPrice.toFixed(2) %></span></span>
                            <span class="text-gray-500 text-sm line-through ml-2">$<%= (relatedProduct[i].variants[j].price).toFixed(2)  %></span>
                            <span class="text-green-600 text-xs font-medium ml-2"><%= (((relatedProduct[i].variants[j].price - offerPrice) / relatedProduct[i].variants[j].price) * 100).toFixed(0) %>% off</span>   
                        <% } else {%>
                            <span class="font-bold text-lg">$ <span id="price<%= relatedProduct[i]._id %><%= j %>"><%= (relatedProduct[i].variants[j].price).toFixed(2) %></span></span>
                        <% } %>
                    </div>
                    
                    <% if (user) { %>
                      <% if (!relatedProduct[i].variants[j].isBlocked && !relatedProduct[i].categoryId.isDeleted && !relatedProduct[i].brandId.isDeleted) { %>  
                                  <% let isProductInCart = cartItems.find(item =>  String(relatedProduct[i]._id) === String(item.productId._id) && item.variant === j ) || null %>
                                  <% if (isProductInCart) { %>
                                      <div class="flex  justify-between ">
                                      <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-[0%] bg-yellow-400 hover:bg-yellow-500 text-gray-900  rounded-md font-medium text-sm flex items-center justify-center" onclick="addToCartInitially(this,'<%- i %>','<%- j %>','<%- relatedProduct[i]._id %>','<%- j %>')">
                                          <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> 
                                      </button>
                                          <div id="incDecQtyDiv<%= relatedProduct[i]._id %><%= j %>" class="flex items-center justify-between w-[100%]  rounded-lg   border border-black w-full ">
                                              <button id="decQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full bg-yellow-400 hover:bg-yellow-300 py-1 rounded-l-lg"  onclick="decrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                                  <i data-feather="minus"></i>
                                              </button> 
                                              <input type="text" id="quantity<%= relatedProduct[i]._id %><%= j %>" value="<%= isProductInCart.quantity %>" class=" w-[5rem] px-2 text-xl bg-white font-bold py-[0.22rem] border-black-x-sides text-center" >
                                              <button id="incQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full py-1 bg-yellow-400 hover:bg-yellow-300 rounded-r-lg"  onclick="incrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                                  <i data-feather="plus"></i>
                                              </button>
                                          </div>
                                      </div>
                              <% } else {%>
                                  <!-- <a  href="/home/cart?productId=&variant=&quantity=1"> -->
                                      <div id="incDecQtyDiv<%= relatedProduct[i]._id %><%= j %>" class="flex items-center justify-between w-[100%] bg-yellow-400  border border-black rounded-lg hidden">
                                          <button id="decQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full bg-yellow-400 hover:bg-yellow-300 py-1 rounded-l-lg" onclick="decrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                              <i data-feather="minus"></i>
                                          </button> 
                                          <input type="text" id="quantity<%= relatedProduct[i]._id %><%= j %>" value="1" class=" w-[5rem] bg-white px-2 text-xl  py-[0.22rem] border-black-x-sides text-center" >
                                          <button id="incQtyBtn<%= relatedProduct[i]._id %><%= j %>" type="button" class="text-center flex justify-center w-full h-full py-1 bg-yellow-400 hover:bg-yellow-300 rounded-r-lg" onclick="incrementQuantity('<%= i %>','<%= j %>','<%= relatedProduct[i]._id %>')">
                                              <i data-feather="plus"></i>
                                          </button>
                                      </div>
                                      <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-full bg-yellow-400 hover:bg-yellow-500 text-gray-900 py-2 rounded-md font-medium text-sm flex items-center justify-center" onclick="addToCartInitially(this,'<%- i %>','<%- j %>','<%- relatedProduct[i]._id %>')">
                                          <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> Add to Cart
                                      </button>
                              <% } %>
                        <% } else { %>
                          <button type="button" class="w-full bg-red-400 text-gray-900 py-2 rounded-md font-bold text-sm flex items-center justify-center" disabled>
                             Product Unavailable
                        </button>
                        <% } %>
                    <% } else { %>
                          <button type="button" id="addToCartBtn<%= relatedProduct[i]._id %><%= j %>" class="w-full bg-yellow-400 hover:bg-yellow-500 text-gray-900 py-2 rounded-md font-medium text-sm flex items-center justify-center" onclick="getUserToLogin()">
                            <i data-feather="shopping-cart" class="w-4 h-4 mr-2"></i> Add to Cart
                        </button>
                    <% } %>
                </div>  
                <% } %>
                <% }%>
                <% }%>
             <% } %>
           <% } %>
         <% } %>
      </div>
    </section>

    <% } %>
  </main>

  <!-- Footer -->
  <%- include("../partials/user-side/footer.ejs")%>
<script src="/javascript/user-javascript/productDetailPage.js"></script>
</body>
</html>
