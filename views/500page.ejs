<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/images/novamart.png" type="image/icon-x" />
    <link rel="stylesheet" href="
    /styles/style2.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/feather-icons"></script>
    <title>Novamart - Something Went Wrong</title>
  </head>

  <body class="flex flex-col items-center justify-center p-4 text-white">

    <div class="text-center max-w-md w-full">

      <div
        class="w-24 h-24 bg-white bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6 backdrop-blur-sm"
      >
        <i data-feather="alert-octagon" class="w-12 h-12 text-white"></i>
      </div>

      <h1 class="text-4xl font-bold mb-4">500 - Server Error</h1>

      <p class="text-lg mb-8 opacity-90">
        Something went wrong on our end. Please try again later.
      </p>

      <div class="bg-white bg-opacity-10 rounded-lg p-4 mb-8 backdrop-blur-sm">
        <div class="flex items-center justify-center space-x-2">
          <i data-feather="info" class="w-5 h-5"></i>
          <p>
            Our team has been notified and is working to fix the issue.
          </p>
        </div>
      </div>

      <div class="flex justify-center gap-4">

        <a
          href="<%= route %>"
          class="btn-primary py-3 px-6 rounded-full text-gray-700 font-semibold transition-all duration-300 flex items-center justify-center space-x-2"
        >
          <span>Go to <%= (route === "/") ? "Homepage" : "Dashboard" %></span>
          <i data-feather="home" class="w-5 h-5"></i>
        </a>

        <button
          onclick="location.reload()"
          class="bg-white bg-opacity-20 py-3 px-6 rounded-full font-semibold flex items-center space-x-2 backdrop-blur-sm hover:bg-opacity-30 transition"
        >
          <span>Retry</span>
          <i data-feather="refresh-cw" class="w-5 h-5"></i>
        </button>

      </div>

    </div>

    <script>
      feather.replace();
    </script>

  </body>
</html>