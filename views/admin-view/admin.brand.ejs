<!-- Header -->
<%- include("../partials/admin-side/admin-universal-header.ejs",{title : "Admin - Brand Management"}) %>
<!-- Navbar -->
<%- include("../partials/admin-side/navbar.ejs") %>
<!-- Sidebar -->
<%- include("../partials/admin-side/sidebar.ejs",{dashboardBtn : "",customerBtn : "",categoriesBtn : "",brandsBtn : "active disabled",productsBtn : "",ordersBtn : "",isDisabled : "disabled",offersBtn : "",couponsBtn : "",reportsBtn : ""}) %>
  <!-- Main Content -->
  <div class="main-content">
    
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Brands</h1>
      <!-- <div class="relative">
        <form action="/admin/brands" method="post">
            <input type="text" placeholder="What are you looking for ?" name="search" 
               class="search-bar border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent">
        <i  class="fas fa-search absolute right-3 top-3 text-gray-500"></i>
        </form>

      </div> -->
          <button onclick="document.getElementById('addBrandModal').classList.remove('hidden')" class="addBtn-primary  font-medium text-gray-700 py-2 px-3  rounded-md transition duration-300 ">
            <i class="fa fa-plus text-gray-700"></i>
            Add Brand
          </button>
    </div>
    
    <!-- Add Brand Modal -->
    <div id="addBrandModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg p-6 w-full max-w-md">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold text-gray-800">Add New Brand</h2>
                <button onclick="document.getElementById('addBrandModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-700">
                    <i data-feather="x"></i>
                </button>
            </div>
            
            <form autocomplete="off" class="space-y-4" action="/admin/add-brand" method="post" enctype="multipart/form-data" onsubmit="return validateForm()" novalidate>
                <div>
                    <label for="brandImage" class="block text-sm font-medium text-gray-700 mb-1">Brand Image</label>
                    <div class="mt-1 flex items-center">
                        <span class="inline-block h-16 w-16 border border-gray-300 rounded-full overflow-hidden bg-gray-100">
                            <img id="addBrandImagePreview" src="/images/cloud-image-upload.jpg" class="h-full w-full text-gray-300" >
                        </span>
                        <input type="file" id="brandImage" name="brandImage" class="ml-4 w-[80%]" accept="image/gif, image/jpeg, image/png" onchange="previewImage(this)" >
                    </div>
                </div>
                <div>
                    <label for="brandName" class="block text-sm font-medium text-gray-700 mb-1">Brand Name</label>
                    <input type="text" id="brandName" name="brandName" class="uppercase w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" oninput="isExisting(this)">
                    <div id="validation-message-for-name" class="hidden mt-1 flex items-center ">
                      <i data-feather="info" class="w-4 h-4 text-red-500 mr-1 "></i>
                      <p  class=" text-xs" ></p>
                    </div>
                </div>
                
                <div>
                    <label for="brandDescription" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea id="brandDescription" name="description" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" rows="3"></textarea>
                </div>
                    
                <div class="flex justify-end space-x-3 pt-4">
                    <button type="button" onclick="document.getElementById('addCategoryModal').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2  rounded-md  text-sm font-semibold text-gray-700 btn-primary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
                        Save Brand
                    </button>
                </div>
            </form>
        </div>
    </div>

  
    <div class="flex justify-end mb-4">
      <div class="flex items-center gap-2 mr-4">
        <form autocomplete="off" action="/admin/brands" method="get">
        <span class="text-md text-gray-600">Sort By :</span>
        <select name="sortBy" class="border border-gray-300 rounded-md px-3 py-1 w-[18rem] focus:outline-none focus:ring-2 focus:ring-green-500">
          <option value="recently-created" <%= (sortBy === "recently-created") ? "selected" : "" %>>Brand Recently Created</option>
          <option value="created-long-ago" <%= (sortBy === "created-long-ago") ? "selected" : "" %>>Brand Created Long ago</option>
          <option value="name-a-z" <%= (sortBy === "name-a-z") ? "selected" : "" %>>Brand Name A-Z</option>
          <option value="name-z-a" <%= (sortBy === "name-z-a") ? "selected" : "" %>>Brand Name Z-A</option>
        </select>
        <button type="submit" class="btn-primary font-medium text-gray-700   rounded-md transition duration-300 ">
          <div class="flex justify-center">
           <h1 class="font-bold p-2">Apply</h1>
          </div>
        </button>
       </form>
      </div>
      <div class="flex items-center gap-2">
        <form action="/admin/items-per-page" method="get">
        <span class="text-md text-gray-600">Items per page:</span>
        <select name="itemsPerPage" class="border border-gray-300 rounded-md px-3 py-1 focus:outline-none focus:ring-2 focus:ring-green-500">
          <option value="5" <%= (perPage === 5) ? "selected" : "" %>>5</option>
          <option value="10" <%= (perPage === 10) ? "selected" : "" %>>10</option>
          <option value="25" <%= (perPage === 25) ? "selected" : "" %>>25</option>
          <option value="50" <%= (perPage === 50) ? "selected" : "" %>>50</option>
          <option value="100" <%= (perPage === 100) ? "selected" : "" %>>100</option>
        </select>
        <button type="submit" class="tick-primary font-medium text-gray-700   rounded-md transition duration-300 ">
          <div class="flex justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" id="tick">
              <polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" points="2.75 8.75 6.25 12.25 13.25 4.75" />
            </svg>
          </div>
        </button>
       </form>
      </div>
    </div>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-green-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold  text-green-800 uppercase tracking-wider">No</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold  text-green-800 uppercase tracking-wider">Brand</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Description</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Status</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Created Date</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if (brands.length === 0) { %>
            <tr>
              <td colspan="6" class="px-6 py-4 whitespace-nowrap text-sm text-center italic text-gray-500">
                No brands added yet !
              </td>
            </tr>
          <% } %>
          <% for(let i = 0; i < brands.length; i++ ) { %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500"><%= i+1 %></td>
            <td class="px-6 py-4 whitespace-wrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <% if (brands[i].brandImage === null) { %>
                    <img class="h-10 w-10 border border-gray-700 rounded-full" src="/images/global.jpg" alt="">
                  <% } else {%>
                    <img class="h-10 w-10 border border-gray-300 rounded-full" src="<%= brands[i].brandImage %>" alt="">
                  <% } %>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium uppercase text-gray-900"><%= brands[i].brandName%></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 flex-wrap  text-sm text-center text-gray-500">
              <% if (brands[i].description === "" || brands[i].description === null || brands[i].description === undefined) { %>
              NP
              <% }else{ %>
              <%= brands[i].description %>
                <% } %>
            </td>
            <td class="px-6 py-2 whitespace-nowrap text-sm font-large text-gray-500">
                <% if (!brands[i].isDeleted) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Inactive</span> 
                <% } %>
            </td>
            <td class="px-6 py-2 whitespace-nowrap text-sm font-large text-gray-500">
                <%= brands[i].createdAt.toDateString() %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">

                <button onclick="document.getElementById('editBrandModal<%= i %>').classList.remove('hidden')" title="Edit" class="text-cyan-500 hover:text-cyan-700 mr-3 unblock-user-btn" >
                    <i class="fas fa-edit"></i>
                </button>
                <!-- Edit Brand Modal -->
                <div id="editBrandModal<%= i %>" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
                    <div class="bg-white rounded-lg p-6 w-full max-w-md">
                        <div class="flex justify-between items-center mb-4">
                            <h2 class="text-xl font-bold text-gray-800">Edit Brand</h2>
                            <button onclick="document.getElementById('editBrandModal<%= i %>').classList.add('hidden')" class="text-gray-500 hover:text-gray-700">
                                <i data-feather="x"></i>
                            </button>
                        </div>
                        
                        <form id="editBrandForm<%= i %>" class="space-y-4" >
                            <div>
                                <label for="editBrandImage" class="block text-sm font-medium text-gray-700 mb-1">Brand Image</label>
                                <div class="mt-1 flex items-center">
                                    <span class="inline-block h-16 w-16 border border-gray-300 rounded-full overflow-hidden bg-gray-100">
                                        <img id="brandImagePreview<%= i %>" src="<%= brands[i].brandImage %>" class="h-full w-full text-gray-300">
                                    </span>
                                    <input type="file" id="editBrandImage" name="brandImage" class="ml-4" accept="image/gif, image/jpeg, image/png" onchange="previewImage(this,'<%= i %>')">
                                </div>
                            </div>
                            <div>
                                <label for="editBrandName" class="block text-sm font-medium text-gray-700 mb-1">Brand Name</label>
                                <input id="editBrandName" type="text" value="<%= brands[i].brandName %>" name="brandName" class="uppercase w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500">
                            </div>
                            
                            <div>
                                <label for="editBrandDescription" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                                <textarea id="editBrandDescription" name="description"  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500" rows="3"><%= brands[i].description %></textarea>
                            </div>
                                
                            <div class="flex justify-end space-x-3 pt-4">
                                <button type="button" onclick="document.getElementById('editBrandModal<%= i %>').classList.add('hidden')" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                                    Cancel
                                </button>
                                <button type="button" class="px-4 py-2  rounded-md  text-sm font-semibold text-gray-700 btn-primary focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" onclick="updateBrand('<%= i %>','<%= brands[i]._id %>','<%= brands[i].brandName.trim() %>','<%= brands[i].description.trim() %>')">
                                    Update Brand
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <button title="Restore" onclick="restoreBrand('<%= brands[i]._id %>')" 
                     class="text-green-600 hover:text-green-900 mr-3 unblock-user-btn" >
                    <i class="fas fa-check-circle"></i>
                </button>
                <button title="Block" onclick="areYouSure('<%= brands[i]._id %>')" 
                    class="text-red-600 hover:text-red-900 delete-user-btn">
                <i class="fas fa-ban"></i>
               </button>
            </td>
          </tr>
          <% } %>
          <!-- Additional rows would go here -->
        </tbody>
      </table>
    </div>

     

    <!-- Pagination -->
    <div class="flex items-center justify-between mt-4">
      <div class="text-sm text-gray-500">
        Showing <span class="font-medium"><%= (brands.length > 0) ? 1 : 0 %></span> to <span class="font-medium"><%= brands.length %></span> of <span class="font-medium"><%= count %></span> results
      </div>
      <div class="flex space-x-2">
        
        <a href="/admin/brands?page=<%= Number(page) > 1 ? Number(page) - 1 : 1 %><%= (sortBy) ? "&sortBy="+sortBy :  "" %>">
          <% if (Number(page) === 1) { %>
            <button class="px-3 py-1 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" disabled>
              Previous
            </button>
          <% } else {%>
            <button class="px-3 py-1 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" >
              Previous
            </button>
            <% } %>
        
       </a>
       <% let lowerBound = (Math.floor(page / 10) * 10) + 1 %>
       <% let upperBound = lowerBound + 9 %>
       <% lowerBound = (lowerBound > pages && pages > 0) ? pages - 9 : lowerBound %>
       <% let displayedPages = (upperBound > pages) ? pages : upperBound %>
       <% for(let i = lowerBound ; i <= displayedPages; i++ ) { %>
        <a href="/admin/brands?page=<%= i %><%= (sortBy) ? "&sortBy="+sortBy :  "" %>">
          <button class="px-3 py-1 border border-gray-300 rounded-md text-sm font-medium text-white bg-green-600 hover:bg-green-700">
            <%= i %>
          </button>
        </a>
        <% } %>
        <a href="/admin/brands?page=<%= Number(page) < pages ? Number(page) + 1 : pages %><%= (sortBy) ? "&sortBy="+sortBy :  "" %>">
          <% if (Number(page) === pages) { %>
            <button class="px-3 py-1 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" disabled>
              Next
            </button>
          <% } else {%>
            <button class="px-3 py-1 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" >
              Next
            </button>
            <% } %>
        
       </a>
      </div>
    </div>
  </div>

 
<!-- Script -->
<%- include("../../public/javascript/admin-javascript/brandManagmentScript.ejs") %>