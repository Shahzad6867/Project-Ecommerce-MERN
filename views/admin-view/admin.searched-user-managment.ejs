<!-- Header -->
<%- include("../partials/admin-side/admin-universal-header.ejs",{title : "Admin - User Results"}) %>
<!-- Navbar -->
<%- include("../partials/admin-side/navbar.ejs") %>
<!-- Sidebar -->
<%- include("../partials/admin-side/sidebar.ejs",{dashboardBtn : "",customerBtn : "active disabled",categoriesBtn : "",brandsBtn : "",productsBtn : "",ordersBtn : "",offersBtn : "",couponsBtn : "",reportsBtn : ""} ) %>

  <!-- Main Content -->
  <div class="main-content">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Results</h1>
      <div class="relative">
        <form autocomplete="off" action="/admin/users" method="post">
            <input type="search" placeholder="Whom are you looking for ?" name="search" value="<%= search %>"
               class="search-bar border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" data-search>
             <div id="searchResult-box" data-user-card-container>  
             </div>
        <i id="search-icon" class="fas fa-search absolute right-3 top-3 text-gray-500"></i>
        </form>
      </div>
      <div class="relative">
        <a href="/admin/users">
          <button  class="btn-primary w-full font-bold text-gray-700 py-2 px-4 rounded-lg  transition duration-300">
          Clear Results
        </button>  </a> 
      </div>
    </div>
    <template data-user-template>
      <div id="list-item" onclick="setInputForSearch()" >
       <div class="flex-shrink-0 h-10 w-10">
        <img class="h-10 w-10 rounded-full" src="/images/user.jpg" alt="" data-avatar>
       </div>
       <span class="ml-2 font-semibold" data-header ></span>
       <span class="ml-2" data-body ></span>
      </div>
    </template> 
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-green-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold  text-green-800 uppercase tracking-wider">Customer No</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-green-800 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Phone</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-green-800 uppercase tracking-wider">Orders</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-green-800 uppercase tracking-wider">Total Spend</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-green-800 uppercase tracking-wider">Status</th>
            <th scope="col" class="px-6 py-3 text-center text-xs font-semibold text-green-800 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% for( let i = 0; i < users.length; i++ ) { %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500"><%= i+1 %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10">
                  <% if (users[i].profileImage === null) { %>
                    <img class="h-10 w-10 rounded-full" src="/images/user.jpg" alt="">
                  <% } else {%>
                    <img class="h-10 w-10 rounded-full" src="<%= users[i].profileImage %>" alt="">
                  <% } %>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900"><%= users[i].firstName.toUpperCase()+" "+users[i].lastName.toUpperCase() %></div>
                  <div class="text-sm text-gray-500"><%= users[i].email %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500">
              <% if (users[i].phone === "" || users[i].phone === null || users[i].phone === undefined) { %>
              NP
              <% }else{ %>
              <%= users[i].phone %>
                <% } %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500">NA</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-500">NA</td>
            <td class="px-6 py-2 whitespace-nowrap text-sm font-large text-gray-500">
                <% if (!users[i].isBlocked) { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                <% } else { %>
                  <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Blocked</span> 
                <% } %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <button title="Block" onclick="blockUser('<%= users[i]._id %> ')" 
                    class="text-amber-400 hover:text-amber-600 mr-3 block-user-btn" >
                    <i class="fas fa-ban"></i>
                </button>
                <button title="Unblock" onclick="unblockUser('<%= users[i]._id %>')" 
                     class="text-green-600 hover:text-green-900 mr-3 unblock-user-btn" >
                    <i class="fas fa-check-circle"></i>
                </button>
                <button title="Delete" onclick="areYouSure('<%= users[i]._id %>')" 
                    class="text-red-600 hover:text-red-900 delete-user-btn">
                <i class="fas fa-trash"></i>
               </button>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="flex items-center justify-between mt-4">
      <div class="text-sm text-gray-500">
        Showing <span class="font-medium"><%= users.length %></span><span class="font-medium"></span> results
      </div>
    </div>
  </div>

 
  <!-- Script.js -->
<%- include("../../public/javascript/admin-javascript/usersPageScript.ejs")%>
   